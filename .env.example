# ============================================================
# Contoh konfigurasi. Salin nilai asli ke file .env (jangan commit .env).
# ============================================================

# Kredensial portal ETHOL
ETHOL_USERNAME=username@student.pens.ac.id
ETHOL_PASSWORD=password_ethol
ETHOL_USERNAME_2=username_cadangan@student.pens.ac.id
ETHOL_PASSWORD_2=password_cadangan

# Grup tujuan notifikasi
TARGET_GROUP_ID=xxxxxxxxxxxxxxxxxx@g.us

# Gemini AI
GEMINI_API_KEY=isi_api_key_gemini
# GEMINI_API_KEYS=key1,key2,key3

# Kas kelas
KAS_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/xxxx/edit
KAS_PAYMENT_INFO="SEABANK:xxxxxxxx atau Shopee 08xxxxxxxxxx"

# ============================================================
# LOGIN WHATSAPP
# ============================================================

# Isi dengan nomor WhatsApp bot dalam format internasional tanpa +, spasi, atau tanda hubung.
# Contoh: 6281234567890
# Jika dikosongkan, bot akan memakai login QR seperti sebelumnya.
PAIRING_NUMBER=

# Kode negara yang dipakai kalau nomor ditulis dengan awalan 0 (mis. 0812...).
PAIRING_COUNTRY_CODE=62

# Folder penyimpanan sesi. Kosongkan untuk memakai ./session.
# SESSION_DIR=./session

# ============================================================
# DEBUG & PUPPETEER
# ============================================================

# Tampilkan log setiap pesan masuk (berguna saat bot tidak membalas).
DEBUG_MESSAGES=false

# Batas waktu membuka Chromium (milidetik).
PUPPETEER_LAUNCH_TIMEOUT=60000
PUPPETEER_PROTOCOL_TIMEOUT=120000

# Opsional: pakai Chrome sistem, bukan Chrome bawaan Puppeteer.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome

# Jeda sebelum pengecekan portal pertama dan sinkronisasi ETHOL saat bot baru connect.
PORTAL_START_DELAY_MS=300000
ETHOL_SYNC_START_DELAY_MS=120000

# Set false untuk mematikan sementara semua scraping ETHOL/portal.
# WhatsApp tetap jalan dan bisa membalas perintah.
SCRAPER_ENABLED=true

# Chrome tidak akan dijalankan kalau RAM tersedia di bawah nilai ini (MB).
# Mencegah OOM di VPS kecil.
MIN_FREE_MEMORY_MB=300

# Interval keep-alive WhatsApp. Naikkan kalau VPS sering terputus saat menjalankan Chromium.
WA_KEEPALIVE_MS=60000
